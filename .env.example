# Supabase transaction pooler URL (server only)
DATABASE_URL="postgresql://postgres.PROJECT:REPLACE_ME@POOLER:6543/postgres?pgbouncer=true"
# Direct/session connection for migrations and seed (server only)
DIRECT_URL="postgresql://postgres:REPLACE_ME@db.PROJECT.supabase.co:5432/postgres"
# Enable Email OTP in Supabase Auth; disable Anonymous sign-ins.
# Email template must include {{ .Token }} (code), not only a magic link.
# Public SDK configuration; only the Supabase SDK persists session credentials.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_PUBLIC_ANON_KEY"

# Optional: run hosted integration test against a disposable configured app.
# TEST_APP_URL="http://localhost:3000"
